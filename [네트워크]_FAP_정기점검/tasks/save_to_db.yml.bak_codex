---
- name: save_to_db
  set_fact:
    merged: "{{ check_task.stdout_lines | default([]) }}"

- name: Save report data
  fap.common.save_data:
    content:
      data_list: "{{ merged }}"
    protocol: http
    hostname: "{{ inventory_hostname }}"
    data_type: "{{ data_type }}"
    data_key: "{{ data_key }}"
    template_id: "{{ fap.template_id | default(omit) }}"
    job_id: "{{ fap.job_id | default(omit) }}"
  register: db_save
  when:
    - merged is defined
    - merged | length > 0